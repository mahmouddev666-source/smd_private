# ---------------------------------------------------------------------------
# SMD-HR environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Application
APP_NAME="SMD-HR"
APP_ENV="production"           # development | production
APP_URL="http://localhost:3000"
TZ="Africa/Cairo"

# Security (generate with: openssl rand -hex 32)
SECRET_KEY="change-me-to-a-random-32-byte-hex-string"
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_DB="smd_hr"
POSTGRES_USER="smd"
POSTGRES_PASSWORD="change-me"
# Compose overrides this to point at the `db` service. For local runs without
# Docker, use: postgresql+psycopg://smd:change-me@localhost:5432/smd_hr
DATABASE_URL="postgresql+psycopg://smd:change-me@db:5432/smd_hr"

# Web container (nginx) port on the host
WEB_PORT=80

# API
API_HOST="0.0.0.0"
API_PORT=8000
API_BASE_URL="/api"
# Production is same-origin behind nginx, so CORS can stay empty. Set an
# explicit origin only when the frontend is served from another host/port.
CORS_ORIGINS=""

# File storage (company forms / documents)
STORAGE_DIR="/data/uploads"
MAX_UPLOAD_MB=20
LIBREOFFICE_BIN="/usr/bin/libreoffice"

# ---------------------------------------------------------------------------
# ONLYOFFICE Document Server (Phase 2 infrastructure, Phase 3 backend)
#
# OFF by default. Enabling requires BOTH flags below plus the services running:
#   docker compose up -d --build onlyoffice api web
#
#   * The editor publishes no host port: the browser reaches it only through
#     nginx at /onlyoffice/ (same origin, WebSocket proxied).
#   * ONLYOFFICE_JWT_SECRET must be at least 32 characters and is shared by the
#     document-server container and the API (callback signing/validation).
#     Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
ONLYOFFICE_ENABLED=false
ONLYOFFICE_IMAGE=onlyoffice/documentserver:10.0.0.1
ONLYOFFICE_JWT_SECRET="change-me-to-a-random-32-byte-hex-string"

# API -> Document Server, over the internal Docker network only.
ONLYOFFICE_INTERNAL_URL="http://onlyoffice"
ONLYOFFICE_INTERNAL_HOST="onlyoffice"
ONLYOFFICE_CALLBACK_BASE="http://api:8000"

# Office URL tokens and limits (Phase 3)
OFFICE_TOKEN_SECRET=""                 # empty -> falls back to SECRET_KEY
OFFICE_DOWNLOAD_TOKEN_TTL_SECONDS=600
OFFICE_CALLBACK_TOKEN_TTL_SECONDS=43200
OFFICE_SESSION_TTL_MINUTES=60
OFFICE_MAX_FILE_MB=20
OFFICE_MAX_CALLBACK_MB=50
OFFICE_VERSION_RETENTION=0             # 0 = keep every version
OFFICE_LEGACY_CONVERT_ON_UPLOAD=true
OFFICE_REQUIRE_DS_DOWNLOAD_TOKEN=true
OFFICE_ALLOW_COEDITING=false
SUBMISSION_SNAPSHOT_ENABLED=true

# Frontend build-time values (baked into the image by infra/web/Dockerfile)
VITE_ONLYOFFICE_ENABLED=false
VITE_ONLYOFFICE_URL="/onlyoffice"
VITE_OFFICE_LOAD_TIMEOUT_MS=20000

# ZKTeco biometric devices
# Automatic sync runs in a background task every N minutes (minimum 1).
# Disabled automatically when APP_ENV=test. Demo devices are never polled.
ZK_SYNC_INTERVAL_MINUTES=10
ZK_SYNC_ENABLED=true
ZK_TIMEOUT_SECONDS=15

# Backups
BACKUP_DIR="/backups"
BACKUP_RETENTION_DAYS=30
# Scheduled pg_dump runs in the `worker` service (requires postgresql-client).
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
PG_DUMP_BIN="pg_dump"
BACKUP_TIMEOUT_SECONDS=600

# Background worker (ZKTeco polling + backups). The API container sets
# ZK_SYNC_ENABLED=false so only one process polls the terminals.
WORKER_TICK_SECONDS=60

# Business rules (approved with HR; change only with sign-off)
PERMIT_PERSONAL_MAX_HOURS=2
PERMIT_WORK_MAX_HOURS=4
PERMIT_DAILY_MAX_HOURS=4
MISSION_MAX_DAYS=60
MISSION_DEFAULT_ALLOWANCE_PER_DAY=450
MISSION_MAX_ALLOWANCE_PER_DAY=2000

# Licence (T3-18): the signed JSON file is the source of truth.
# Generate it with `python -m app.cli.license generate --help`.
LICENSE_FILE="./license.json"
# Optional HMAC-SHA256 key. When set, the file must carry a matching signature.
# Leave empty for the unsigned development licence. NEVER commit this key.
LICENSE_SIGNING_KEY=""
# Override only in tests/containers; full 64-hex fingerprint.
LICENSE_HARDWARE_ID=""
# Legacy fallback, used only when LICENSE_FILE does not exist.
LICENSE_KEY=""
LICENSE_EXPIRES_ON=""            # ISO date, e.g. 2027-12-31
# Keep false unless an active licence is installed; true blocks startup on
# expired / invalid / hardware_mismatch licences.
LICENSE_ENFORCE=false

# Demo data (codes start at 9001, can be reset without touching real data)
DEMO_MODE=true
# Seed demo data automatically on API container start (idempotent, demo-only).
SEED_DEMO_ON_START=false

# Frontend build variables (must be prefixed with VITE_)
VITE_API_BASE_URL="/api"
# Allow the browser-side demo dataset when the API is unreachable.
# Keep `false` in production; set to `true` only for development/preview builds.
VITE_ALLOW_OFFLINE_DEMO=false
