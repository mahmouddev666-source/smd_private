# ---------------------------------------------------------------------------
# SMD-HR environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Application
APP_NAME="SMD-HR"
APP_ENV="production"           # development | production
APP_URL="http://localhost:3000"
TZ="Africa/Cairo"

# Security (generate with: openssl rand -hex 32)
SECRET_KEY="change-me-to-a-random-32-byte-hex-string"
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_DB="smd_hr"
POSTGRES_USER="smd"
POSTGRES_PASSWORD="change-me"
# Compose overrides this to point at the `db` service. For local runs without
# Docker, use: postgresql+psycopg://smd:change-me@localhost:5432/smd_hr
DATABASE_URL="postgresql+psycopg://smd:change-me@db:5432/smd_hr"

# Web container (nginx) port on the host
WEB_PORT=80

# API
API_HOST="0.0.0.0"
API_PORT=8000
API_BASE_URL="/api"
CORS_ORIGINS="http://localhost:3000,http://localhost"

# File storage (company forms / documents)
STORAGE_DIR="/data/uploads"
MAX_UPLOAD_MB=20
LIBREOFFICE_BIN="/usr/bin/libreoffice"

# ZKTeco biometric devices
ZK_SYNC_INTERVAL_MINUTES=10
ZK_SYNC_ENABLED=true
ZK_TIMEOUT_SECONDS=15

# Backups
BACKUP_DIR="/backups"
BACKUP_RETENTION_DAYS=30

# Demo data (codes start at 9001, can be reset without touching real data)
DEMO_MODE=true
# Seed demo data automatically on API container start (idempotent, demo-only).
SEED_DEMO_ON_START=false

# Frontend build variables (must be prefixed with VITE_)
VITE_API_BASE_URL="/api"
